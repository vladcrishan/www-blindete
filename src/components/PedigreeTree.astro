---
/**
 * 3-generation family tree: animal -> sire/dam -> four grandparents.
 * Grandparents: explicit `grandparents.*` override, else the parent's own
 * sireName/damName. Unknown slots render as an elegant "—".
 */
import type { Animal, AnimalRef } from '../sanity/lib/types';
import { animalPath, type Lang } from '../i18n/ui';

interface Props {
  animal: Pick<Animal, 'name' | 'sire' | 'dam' | 'grandparents' | 'titles'>;
  lang: Lang;
  id?: string;
}
const { animal, lang, id = 'pedigree' } = Astro.props;

const copy = {
  ro: { title: 'Arborele genealogic', eyebrow: 'Linie de sânge', sire: 'Tată', dam: 'Mamă', gSire: 'Bunic', gDam: 'Bunică', unknown: 'Necunoscut' },
  en: { title: 'Family tree', eyebrow: 'Bloodline', sire: 'Sire', dam: 'Dam', gSire: 'Grandsire', gDam: 'Granddam', unknown: 'Unknown' },
}[lang];

type Slot = { name?: string; slug?: string; label: string };
const gp = animal.grandparents ?? {};
const pick = (...v: (string | undefined | null)[]) => v.find((x) => x && x.trim())?.trim();

const sire: Slot = { name: animal.sire?.name, slug: animal.sire?.slug, label: copy.sire };
const dam: Slot = { name: animal.dam?.name, slug: animal.dam?.slug, label: copy.dam };
const kids = (p?: AnimalRef | null, a?: string, b?: string): Slot[] => [
  { name: pick(a, p?.sireName), label: copy.gSire },
  { name: pick(b, p?.damName), label: copy.gDam },
];
const branches = [
  { node: sire, kids: kids(animal.sire, gp.sireSire, gp.sireDam) },
  { node: dam, kids: kids(animal.dam, gp.damSire, gp.damDam) },
];
---

<section id={id} class="scroll-mt-24" aria-labelledby={`${id}-title`}>
  <p class="eyebrow">{copy.eyebrow}</p>
  <h2 id={`${id}-title`} class="mt-3 text-3xl sm:text-4xl">{copy.title}</h2>

  <div class="mt-10 overflow-x-auto pb-2">
    <div class="pt-tree flex min-w-[640px] items-center" role="group" aria-label={copy.title}>
      <div class="pt-card pt-card--root">
        {animal.titles && <span class="eyebrow">{animal.titles}</span>}
        <span class="font-display text-2xl">{animal.name}</span>
      </div>
      <span class="pt-stub" aria-hidden="true"></span>
      <div class="pt-col">
        {
          branches.map((b) => (
            <div class="pt-kid">
              <div class="flex items-center">
                {b.node.name && b.node.slug ? (
                  <a href={animalPath(b.node.slug, lang)} class="pt-card pt-card--link">
                    <span class="pt-label">{b.node.label}</span>
                    <span class="pt-name">{b.node.name}</span>
                  </a>
                ) : (
                  <div class="pt-card">
                    <span class="pt-label">{b.node.label}</span>
                    {b.node.name ? (
                      <span class="pt-name">{b.node.name}</span>
                    ) : (
                      <span class="pt-name pt-empty" aria-label={copy.unknown}>—</span>
                    )}
                  </div>
                )}
                <span class="pt-stub" aria-hidden="true"></span>
                <div class="pt-col">
                  {b.kids.map((k) => (
                    <div class="pt-kid">
                      <div class="pt-card pt-card--small">
                        <span class="pt-label">{k.label}</span>
                        {k.name ? (
                          <span class="pt-name">{k.name}</span>
                        ) : (
                          <span class="pt-name pt-empty" aria-label={copy.unknown}>—</span>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .pt-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .pt-kid {
    position: relative;
    padding: 0.375rem 0 0.375rem 1.5rem;
  }
  .pt-kid::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 1.5rem;
    height: 1px;
    background: var(--color-sand);
  }
  .pt-kid::after {
    content: '';
    position: absolute;
    left: 0;
    width: 1px;
    background: var(--color-sand);
    top: 0;
    bottom: 0;
  }
  .pt-kid:first-child::after {
    top: 50%;
  }
  .pt-kid:last-child::after {
    bottom: 50%;
  }
  .pt-stub {
    display: block;
    width: 1.5rem;
    height: 1px;
    background: var(--color-sand);
    flex: none;
  }
  .pt-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 11rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-line);
    background: var(--color-cream-soft);
  }
  .pt-card--root {
    min-width: 12rem;
    padding: 1.25rem 1.25rem;
    background: var(--color-ink);
    color: #fff;
    border-color: var(--color-ink);
  }
  .pt-card--small {
    min-width: 10rem;
    background: transparent;
  }
  .pt-card--link {
    transition: border-color 0.2s ease;
  }
  .pt-card--link:hover,
  .pt-card--link:focus-visible {
    border-color: var(--color-sand);
  }
  .pt-label {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-sand-dark);
  }
  .pt-name {
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .pt-empty {
    color: var(--color-mute);
  }
</style>
