---
/**
 * Photo with brand protection (Notion requirement "photo protection"):
 *  - a CSS "blîndețe" watermark over the image (bottom-right signature, or a
 *    larger centred mark for full-size previews),
 *  - right-click / drag disabled (global handler in BaseLayout targets
 *    `[data-protected]`), plus the footer copyright disclaimer.
 *
 * This is a deterrent, not DRM: the CDN URL is still in the HTML. Burned-in
 * watermarks would need a server-side image pipeline (not available).
 *
 * Use for EVERY animal/gallery photo instead of <SanityImage> directly.
 * Pass either a Sanity `image` or a bundled `local` asset (fallbacks).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import SanityImage from './SanityImage.astro';
import type { SanityImageWithAlt } from '../sanity/lib/types';

interface Props {
  image?: SanityImageWithAlt | null;
  /** Bundled fallback asset (e.g. hero photos before the owner uploads). */
  local?: ImageMetadata;
  alt?: string;
  width?: number;
  aspect?: string;
  priority?: boolean;
  sizes?: string;
  /** Classes for the <img> (e.g. "h-full w-full object-cover"). */
  class?: string;
  /** Classes for the wrapper (positioning / sizing / photo-grade). */
  wrapperClass?: string;
  /** corner = small signature (default); center = large mark for previews; none = no mark. */
  mark?: 'corner' | 'center' | 'none';
}

const {
  image,
  local,
  alt,
  width = 800,
  aspect,
  priority = false,
  sizes,
  class: imgClass,
  wrapperClass,
  mark = 'corner',
} = Astro.props;

const altText = alt ?? image?.alt ?? '';
// Positioning: callers may pass `absolute`; default to `relative` so the mark
// has a containing block.
const positioned = /\b(absolute|fixed|relative|sticky)\b/.test(wrapperClass ?? '');
---

{
  (image?.asset || local) && (
    <div
      class:list={['protected-photo overflow-hidden', !positioned && 'relative', wrapperClass]}
      data-protected
    >
      {image?.asset ? (
        <SanityImage
          image={image}
          alt={altText}
          width={width}
          aspect={aspect}
          priority={priority}
          sizes={sizes}
          class={imgClass}
        />
      ) : (
        local && (
          <Picture
            src={local}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[Math.round(local.width / 2), local.width]}
            sizes={sizes ?? '100vw'}
            alt={altText}
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
            decoding="async"
            class={imgClass}
            pictureAttributes={{ class: 'contents' }}
            style={aspect ? `aspect-ratio:${aspect};object-fit:cover;` : undefined}
          />
        )
      )}
      {mark !== 'none' && (
        <span
          class:list={['protected-photo__mark', mark === 'center' && 'protected-photo__mark--center']}
          aria-hidden="true"
        >
          blîndețe
        </span>
      )}
    </div>
  )
}
