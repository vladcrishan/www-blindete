---
import {
  useTranslations,
  localizedRoute,
  switchLocalePath,
  getLangFromUrl,
  type Lang,
} from '../i18n/ui';

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherLang: Lang = lang === 'en' ? 'ro' : 'en';
const switchHref = switchLocalePath(Astro.url, otherLang);

const nav = [
  { id: 'cats', label: t('nav.cats') },
  { id: 'dogs', label: t('nav.dogs') },
  { id: 'contact', label: t('nav.contact') },
] as const;

const current = Astro.url.pathname;
const isActive = (id: (typeof nav)[number]['id']) => {
  const href = localizedRoute(id, lang);
  return current === href || current.startsWith(href + '/');
};
---

<header class="bg-bg/95 sticky top-0 z-40 backdrop-blur">
  <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-4 px-6 py-5">
    <a
      href={localizedRoute('home', lang)}
      class="text-xl font-bold tracking-tight"
      style="font-family:var(--font-display)"
    >
      {t('brand.name')}<span class="text-ink">.</span>
    </a>

    <nav class="hidden items-center gap-9 md:flex" aria-label="Principal">
      {
        nav.map((item) => (
          <a
            href={localizedRoute(item.id, lang)}
            class:list={[
              'hover:text-gold text-sm tracking-wide transition',
              isActive(item.id) ? 'text-gold' : 'text-ink',
            ]}
            aria-current={isActive(item.id) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={switchHref}
        class="text-mut hover:text-gold text-sm tracking-wide transition"
        hreflang={otherLang}
      >
        {otherLang.toUpperCase()}
      </a>
    </nav>

    <button
      type="button"
      class="text-2xl leading-none md:hidden"
      aria-label="Meniu"
      data-menu-toggle>☰</button
    >
  </div>

  <nav
    class="border-line hidden border-t px-6 pt-2 pb-4 md:hidden"
    data-mobile-menu
    aria-label="Mobil"
  >
    {
      nav.map((item) => (
        <a
          href={localizedRoute(item.id, lang)}
          class:list={['block py-2 text-sm tracking-wide', isActive(item.id) && 'text-gold']}
          aria-current={isActive(item.id) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <a href={switchHref} class="text-mut block py-2 text-sm tracking-wide" hreflang={otherLang}>
      {t('lang.switchTo')}
    </a>
  </nav>
</header>

<script is:inline>
  document.querySelector('[data-menu-toggle]')?.addEventListener('click', () => {
    document.querySelector('[data-mobile-menu]')?.classList.toggle('hidden');
  });
</script>
