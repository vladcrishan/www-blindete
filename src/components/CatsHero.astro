---
/**
 * Editorial "Persian Cats" hero — faithful to the Figma "Cats" design.
 *
 * Desktop layout (>=md): a 12-col grid.
 *   - Tall portrait photo pinned left (cols 1-5), title overlapping its right edge.
 *   - Big two-line display title (cols 4-9), placed near the top.
 *   - "FOR BREEDERS / AND PETS" eyebrow mid-right.
 *   - Secondary portrait photo bottom-right (cols 9-12).
 *   - "TOP QUALITY / PURE BREED" copy block lower-center, left of photo 2.
 *   - Rotated breed labels (Chinchilla / Golden / Silver) on the far right edge.
 *
 * Mobile: everything stacks in a sensible reading order.
 * Photos are fixed editorial assets (not Sanity-managed). Imported so Astro
 * fingerprints them; served as-is (the project optimizes via Sanity's CDN, so
 * no local Sharp pipeline is involved).
 */
import catHero1 from '../assets/cat-hero-1.png';
import catHero2 from '../assets/cat-hero-2.png';
import { localizedRoute, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const en = lang === 'en';

const title = en ? ['Persian', 'Cats'] : ['Pisici', 'persane'];
const breeds = ['Chinchilla', 'Golden', 'Silver'];
const forLine = en
  ? ['For', 'breeders', 'and', 'pets']
  : ['Pentru', 'crescători', 'și', 'iubitori'];
const eyebrow = en ? 'Top quality' : 'Calitate de top';
const headline = en ? 'Pure breed' : 'Rasă pură';
const body = en
  ? 'It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout.'
  : 'Pisici Persane Chinchilla crescute cu drag în Arad — sănătoase, blânde și pregătite pentru o nouă familie.';
const seeMore = en ? 'see more' : 'vezi mai mult';
const href = localizedRoute('cats', lang);

const alt1 = en ? 'Persian Chinchilla cat grooming' : 'Pisică Persană Chinchilla';
const alt2 = en ? 'Persian Chinchilla cat sleeping' : 'Pisică Persană Chinchilla dormind';
---

<section class="mx-auto max-w-[1200px] px-6 pt-4 pb-16 md:pt-2 md:pb-24">
  <!--
    Desktop overlapping editorial layout. A relative box with a fixed aspect
    ratio (matching the Figma frame proportions) anchors every element by
    percentage so the overlaps stay faithful at any width >= md.
  -->
  <div class="relative hidden aspect-[1180/940] w-full md:block">
    <!-- Left tall photo -->
    <div class="absolute top-[6%] left-0 z-0 h-[80%] w-[37%] overflow-hidden">
      <img
        src={catHero1.src}
        width={catHero1.width}
        height={catHero1.height}
        alt={alt1}
        loading="eager"
        decoding="async"
        class="h-full w-full object-cover"
      />
    </div>

    <!-- Secondary photo bottom-right -->
    <div class="absolute right-0 bottom-0 z-0 h-[55%] w-[32%] overflow-hidden">
      <img
        src={catHero2.src}
        width={catHero2.width}
        height={catHero2.height}
        alt={alt2}
        loading="eager"
        decoding="async"
        class="h-full w-full object-cover"
      />
    </div>

    <!-- Big display title overlapping the photo -->
    <h1
      class="font-display pointer-events-none absolute top-[3%] left-[35%] z-10 leading-[0.9] tracking-tight"
    >
      <span class="block text-[6.5rem] lg:text-[8rem] xl:text-[9rem]">{title[0]}</span>
      <span class="block text-[6.5rem] lg:text-[8rem] xl:text-[9rem]">{title[1]}</span>
    </h1>

    <!-- "For breeders and pets" eyebrow, mid-right -->
    <p class="font-display absolute top-[38%] right-[12%] z-10 text-sm leading-tight uppercase">
      <span class="text-gold">{forLine[0]}</span><br />
      <span class="text-gold">{forLine[1]}</span><br />
      <span class="text-ink">{forLine[2]}</span><br />
      <span class="text-ink">{forLine[3]}</span>
    </p>

    <!-- Copy block: lower-center, left of the secondary photo -->
    <div class="absolute bottom-[8%] left-[40%] z-10 w-[26%]">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="font-display mt-1 text-2xl font-bold tracking-wide uppercase">{headline}</h2>
      <p class="text-mut mt-4 text-sm leading-relaxed">{body}</p>
      <a
        href={href}
        class="hover:text-gold mt-6 inline-flex items-center gap-4 text-sm tracking-wide"
      >
        {seeMore}
        <span class="bg-ink inline-block h-px w-12"></span>
      </a>
    </div>

    <!-- Rotated breed labels on the far right edge -->
    <ul class="absolute top-[8%] right-0 z-10 flex flex-col items-center gap-12">
      {breeds.map((b) => <li class="vlabel font-display text-ink! tracking-[0.25em]!">{b}</li>)}
    </ul>
  </div>

  <!-- Mobile stacked layout -->
  <div class="md:hidden">
    <h1 class="font-display leading-[0.95] tracking-tight">
      <span class="block text-6xl sm:text-7xl">{title[0]}</span>
      <span class="block text-6xl sm:text-7xl">{title[1]}</span>
    </h1>

    <p class="font-display mt-4 text-xs leading-tight uppercase">
      <span class="text-gold">{forLine[0]} {forLine[1]}</span> {forLine[2]} {forLine[3]}
    </p>

    <div class="mt-6 overflow-hidden">
      <img
        src={catHero1.src}
        width={catHero1.width}
        height={catHero1.height}
        alt={alt1}
        loading="eager"
        decoding="async"
        class="aspect-[3/4] w-full object-cover"
      />
    </div>

    <div class="mt-8">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="font-display mt-1 text-2xl font-bold tracking-wide uppercase">{headline}</h2>
      <p class="text-mut mt-4 leading-relaxed">{body}</p>
      <a
        href={href}
        class="hover:text-gold mt-6 inline-flex items-center gap-4 text-sm tracking-wide"
      >
        {seeMore}
        <span class="bg-ink inline-block h-px w-12"></span>
      </a>
    </div>

    <div class="mt-8 overflow-hidden">
      <img
        src={catHero2.src}
        width={catHero2.width}
        height={catHero2.height}
        alt={alt2}
        loading="eager"
        decoding="async"
        class="aspect-[4/5] w-full object-cover"
      />
    </div>

    <ul class="text-mut mt-8 flex gap-6 text-xs tracking-[0.25em] uppercase">
      {breeds.map((b) => <li class="font-display">{b}</li>)}
    </ul>
  </div>
</section>
