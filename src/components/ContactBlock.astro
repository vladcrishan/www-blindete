---
/**
 * "Visit us" contact block (home + sub-site pages): on white, opened by the
 * site's ink rule. Left: place, a short note, phone | visits in hairline-ruled
 * columns, Call / Message buttons. Right: map with a sand pin and place label,
 * captioned with city-level coordinates and a directions link.
 *
 * The map is a real OpenStreetMap render of the area (public/map-arad.svg);
 * the whole map links to Google Maps. Location stays neighbourhood-level, no exact address.
 */
import ContactButtons from './ContactButtons.astro';
import { routes, useTranslations, type Lang } from '../i18n/ui';
import type { SiteSettings } from '../sanity/lib/types';

interface Props {
  lang: Lang;
  settings: SiteSettings | null;
  /** Google Maps query (e.g. street area). Defaults to the city. */
  query?: string;
}
const { lang, settings, query } = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';

const city = settings?.city ?? 'Arad';
const place = en ? `${city}, Romania` : `${city}, România`;
const q = encodeURIComponent(query ?? place);
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${q}`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${q}`;

const copy = en
  ? {
      eyebrow: 'Visit us',
      note: 'Every kitten and puppy is raised at home and can be met in person, by appointment.',
      phone: 'Phone',
      visits: 'Visits',
      visitsValue: `By appointment · ${city}`,
      directions: 'Get directions',
    }
  : {
      eyebrow: 'Vizitează-ne',
      note: 'Fiecare pui este crescut în casă și poate fi cunoscut personal, cu programare.',
      phone: 'Telefon',
      visits: 'Vizite',
      visitsValue: `Cu programare · ${city}`,
      directions: 'Indicații de orientare',
    };

---

<section>
  <div class="mx-auto max-w-[1288px] px-6">
    <div
      class="border-ink grid items-center gap-12 border-t pt-14 pb-20 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:pt-20 md:pb-28 lg:gap-20"
    >
      <!-- Text -->
      <div>
        <p class="text-sand text-[13px] tracking-[0.2em] uppercase">{copy.eyebrow}</p>
        <h2 class="mt-4 text-5xl leading-[1.05] lg:text-6xl">{place}</h2>
        <p class="text-mute mt-6 max-w-md text-[15px] leading-relaxed">{copy.note}</p>

        <!-- Phone | Visits: two hairline-ruled columns -->
        <dl class="border-line mt-10 grid grid-cols-2 border-y">
          {
            settings?.phone && (
              <div class="border-line border-r py-6 pr-5">
                <dt class="text-sand text-xs tracking-[0.2em] uppercase">{copy.phone}</dt>
                <dd class="mt-3">
                  <a
                    href={`tel:${settings.phone.replace(/\s+/g, '')}`}
                    class="hover:text-sand-dark text-[1.35rem] leading-tight whitespace-nowrap transition lg:text-2xl"
                  >
                    {settings.phone}
                  </a>
                </dd>
              </div>
            )
          }
          <div class:list={['py-6', settings?.phone ? 'pl-6' : 'col-span-2']}>
            <dt class="text-sand text-xs tracking-[0.2em] uppercase">{copy.visits}</dt>
            <dd class="mt-3 text-base leading-[1.6]">{copy.visitsValue}</dd>
          </div>
        </dl>

        <div class="mt-10">
          <ContactButtons
            settings={settings}
            lang={lang}
            buttons={['call', 'message']}
            messageHref={routes.contact[lang]}
          />
        </div>
      </div>

      <!-- Map (real OSM render) + caption -->
      <figure>
        <a
          href={mapsHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${place} · ${t('cta.viewMap')}`}
          class="group relative block aspect-[4/3] w-full overflow-hidden"
        >
          <!-- Real OSM geometry around Str. Bagdazar, drawn in the site's illustrated style
               (public/map-arad.svg, generated by scripts/render-map.mjs) -->
          <img
            src="/map-arad.svg"
            alt=""
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <!-- pin at the centre of the render -->
          <svg
            viewBox="0 0 120 120"
            class="map-pin absolute top-1/2 left-1/2 h-[96px] w-[96px] -translate-x-1/2 -translate-y-1/2"
            aria-hidden="true"
          >
            <circle cx="60" cy="60" r="56" fill="#c4b27c" opacity="0.14"></circle>
            <circle cx="60" cy="60" r="30" fill="#c4b27c" opacity="0.2"></circle>
            <circle cx="60" cy="60" r="19" fill="#ffffff"></circle>
            <circle cx="60" cy="60" r="13.5" fill="#c4b27c"></circle>
          </svg>
          <!-- label in HTML so the text stays crisp and doesn't scale with the SVG -->
          <span
            class="border-line text-ink absolute top-1/2 left-1/2 ml-8 -translate-y-[150%] border bg-white px-3.5 py-2 text-sm whitespace-nowrap shadow-[0_1px_2px_rgb(0_0_0/0.04)]"
          >
            {place}
          </span>
        </a>
        <figcaption class="mt-4 flex items-center justify-between gap-4 text-sm">
          <span class="text-mute text-xs tracking-[0.2em] uppercase">46.14° N · 21.31° E</span>
          <a
            href={directionsHref}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-sand-dark inline-flex items-center gap-2.5 transition"
          >
            {copy.directions}
            <svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8"></path>
            </svg>
          </a>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .map-pin {
      transition: scale 0.35s ease;
    }
    .group:hover .map-pin {
      scale: 1.08;
    }
  }
</style>
