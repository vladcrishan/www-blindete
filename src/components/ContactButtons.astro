---
import { useTranslations, type Lang } from '../i18n/ui';
import type { SiteSettings } from '../sanity/lib/types';

interface Props {
  settings: SiteSettings | null;
  lang: Lang;
  /** Optional message prefill (e.g. animal name) for WhatsApp/Messenger. */
  context?: string;
}
const { settings, lang, context } = Astro.props;
const t = useTranslations(lang);

const waNumber = settings?.whatsapp?.replace(/[^\d]/g, '');
const waText = context
  ? encodeURIComponent(
      lang === 'en'
        ? `Hello! I'm interested in ${context}.`
        : `Bună ziua! Sunt interesat(ă) de ${context}.`,
    )
  : '';
const waHref = waNumber ? `https://wa.me/${waNumber}${waText ? `?text=${waText}` : ''}` : null;
---

<div class="flex flex-wrap gap-3">
  {
    settings?.phone && (
      <a
        href={`tel:${settings.phone}`}
        class="rounded-pill bg-brand hover:bg-brand-dark inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-white transition"
      >
        📞 {t('cta.call')}
      </a>
    )
  }
  {
    waHref && (
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-pill inline-flex items-center gap-2 bg-[#25D366] px-5 py-2.5 text-sm font-semibold text-white transition hover:opacity-90"
      >
        💬 {t('cta.whatsapp')}
      </a>
    )
  }
  {
    settings?.messenger && (
      <a
        href={settings.messenger}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-pill inline-flex items-center gap-2 bg-[#0084FF] px-5 py-2.5 text-sm font-semibold text-white transition hover:opacity-90"
      >
        ✉ {t('cta.messenger')}
      </a>
    )
  }
</div>
