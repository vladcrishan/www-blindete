---
import { useTranslations, type Lang } from '../i18n/ui';
import type { SiteSettings } from '../sanity/lib/types';
import Icon from './Icon.astro';

type ContactButton = 'call' | 'whatsapp' | 'messenger' | 'message';

interface Props {
  settings: SiteSettings | null;
  lang: Lang;
  /** Optional message prefill (e.g. animal name) for WhatsApp/Messenger. */
  context?: string;
  /**
   * Which buttons to render, in order. Defaults to the direct-contact set
   * (call + whatsapp + messenger). Pass e.g. ['call', 'message'] for the
   * home contact block where "message" links to the on-site form.
   */
  buttons?: ContactButton[];
  /** Target for the "message" button (the contact form / section). */
  messageHref?: string;
}
const {
  settings,
  lang,
  context,
  buttons = ['call', 'whatsapp', 'messenger'],
  messageHref,
} = Astro.props;
const t = useTranslations(lang);

const show = (b: ContactButton) => buttons.includes(b);

const waNumber = settings?.whatsapp?.replace(/[^\d]/g, '');
const waText = context
  ? encodeURIComponent(
      lang === 'en'
        ? `Hello! I'm interested in ${context}.`
        : `Bună ziua! Sunt interesat(ă) de ${context}.`,
    )
  : '';
const waHref = waNumber ? `https://wa.me/${waNumber}${waText ? `?text=${waText}` : ''}` : null;
---

<div class="flex flex-wrap gap-3">
  {
    show('call') && settings?.phone && (
      <a
        href={`tel:${settings.phone}`}
        class="rounded-pill bg-brand-dark hover:bg-gold inline-flex items-center gap-2.5 px-7 py-3.5 text-lg font-semibold text-ink transition"
      >
        <Icon name="phone" size={22} />
        {t('cta.call')}
      </a>
    )
  }
  {
    show('message') && messageHref && (
      <a
        href={messageHref}
        class="rounded-pill bg-brand-dark hover:bg-gold inline-flex items-center gap-2.5 px-7 py-3.5 text-lg font-semibold text-ink transition"
      >
        <Icon name="message" size={22} />
        {t('cta.message')}
      </a>
    )
  }
  {
    show('whatsapp') && waHref && (
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-pill inline-flex items-center gap-2.5 bg-[#25D366] px-7 py-3.5 text-lg font-semibold text-white transition hover:opacity-90"
      >
        <Icon name="whatsapp" size={24} />
        {t('cta.whatsapp')}
      </a>
    )
  }
  {
    show('messenger') && settings?.messenger && (
      <a
        href={settings.messenger}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-pill inline-flex items-center gap-2.5 bg-[#0084FF] px-7 py-3.5 text-lg font-semibold text-white transition hover:opacity-90"
      >
        <Icon name="message" size={22} />
        {t('cta.messenger')}
      </a>
    )
  }
</div>
