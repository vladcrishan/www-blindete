---
import type { Animal } from '../sanity/lib/types';
import { useTranslations, animalPath, type Lang } from '../i18n/ui';
import ProtectedImage from './ProtectedImage.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  animal: Animal;
  lang: Lang;
}

const { animal, lang } = Astro.props;
const t = useTranslations(lang);
const href = animalPath(animal.slug, lang);
const cover = animal.photos?.[0];
const gender = animal.gender ? t(`animal.gender.${animal.gender}` as const) : '';
const meta = [gender, animal.color].filter(Boolean).join(' · ');
---

<a href={href} class="group block" data-status={animal.status}>
  <div class="bg-cream-soft relative aspect-[6/5] overflow-hidden">
    {
      cover ? (
        <ProtectedImage
          image={cover}
          alt={cover.alt ?? animal.name}
          width={720}
          aspect="6/5"
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 380px"
          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
          wrapperClass="h-full w-full"
        />
      ) : (
        <div class="text-mute flex h-full items-center justify-center text-xs tracking-[0.2em] uppercase">
          blîndețe
        </div>
      )
    }
  </div>
  <div class="mt-4 flex items-center justify-between gap-3">
    <h3 class="font-sans text-xl leading-snug">{animal.name}</h3>
    <StatusBadge status={animal.status} lang={lang} />
  </div>
  {meta && <p class="text-mute mt-1 text-sm">{meta}</p>}
</a>
