---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SanityImage from '../SanityImage.astro';
import AnimalCard from '../AnimalCard.astro';
import ContactButtons from '../ContactButtons.astro';
import CatsHero from '../CatsHero.astro';
import DogsHero from '../DogsHero.astro';
import StaticMap from '../StaticMap.astro';
import JsonLd from '../JsonLd.astro';
import { useTranslations, localized, routes, type Lang } from '../../i18n/ui';
import { getSiteSettings, getFeaturedAnimals, getAvailableCount } from '../../sanity/lib/queries';
import { petStoreSchema, ogImageUrl } from '../../sanity/lib/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const [settings, featured, availableCount] = await Promise.all([
  getSiteSettings(),
  getFeaturedAnimals(),
  getAvailableCount(),
]);

const heroTitle = localized(settings?.heroTitleRo, settings?.heroTitleEn, lang);
const heroSubtitle = localized(settings?.heroSubtitleRo, settings?.heroSubtitleEn, lang);

const seoTitle =
  lang === 'en'
    ? 'blindete · Persian Chinchilla Cats & Pomeranian Dogs in Arad'
    : 'blîndețe · Pisici Persane Chinchilla și Câini Pomeranian în Arad';
const seoDesc =
  lang === 'en'
    ? 'Ethical breeder of Persian Chinchilla kittens and Pomeranian / Kleinspitz puppies in Arad, Romania. See available animals and get in touch.'
    : 'Crescătorie de pisici Persane Chinchilla și câini Pomeranian / Kleinspitz în Arad, România. Vezi animalele disponibile și contactează-ne.';

const ogImg = settings?.heroImage ? ogImageUrl(settings.heroImage) : undefined;
const homeUrl = new URL(routes.home[lang], Astro.site ?? 'https://blindete.ro').href;
const schema = petStoreSchema(settings, { url: homeUrl, lang, image: ogImg });

const availableLabel = availableCount === 1 ? t('home.available.one') : t('home.available.many');
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  roPath={routes.home.ro}
  enPath={routes.home.en}
  ogImage={ogImg}
  settings={settings}
>
  <JsonLd slot="head" schema={schema} />

  <!-- Editorial "Persian Cats" hero (Figma) -->
  <CatsHero lang={lang} />

  <!-- Editorial "Pomeranian Dogs" hero (Figma, mirrored) -->
  <DogsHero lang={lang} />

  <div class="mx-auto max-w-[1200px] px-6">
    <!-- Optional editorial hero intro from settings -->
    {
      (heroTitle || heroSubtitle) && (
        <section class="grid items-center gap-8 py-12 md:grid-cols-2 md:py-20">
          <div>
            {heroTitle && <h1 class="text-5xl sm:text-6xl">{heroTitle}</h1>}
            {heroSubtitle && <p class="text-mut mt-5 max-w-md leading-relaxed">{heroSubtitle}</p>}
            {availableCount > 0 && (
              <p class="mt-6 text-sm">
                <span class="font-display text-gold text-2xl">{availableCount}</span>
                <span class="text-mut ml-2">{availableLabel}</span>
              </p>
            )}
          </div>
          {settings?.heroImage && (
            <SanityImage
              image={settings.heroImage}
              alt={settings.heroImage.alt ?? heroTitle ?? t('brand.name')}
              width={900}
              aspect="4/5"
              priority
              sizes="(max-width: 768px) 100vw, 560px"
              class="w-full"
            />
          )}
        </section>
      )
    }

    <!-- Featured strip (if more than the 4 shown above) -->
    {
      featured.length > 0 && (
        <section class="border-line border-t py-16">
          <h2 class="text-3xl sm:text-4xl">{t('home.featured')}</h2>
          <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {featured.slice(0, 6).map((animal) => (
              <AnimalCard animal={animal} lang={lang} />
            ))}
          </div>
        </section>
      )
    }

    <!-- Contact block (Figma: address + phone + gold button) -->
    <section class="border-line grid items-center gap-8 border-t py-16 md:grid-cols-2 md:py-24">
      <StaticMap
        place={settings?.city ?? 'Arad'}
        query="Strada Bagdazar, Arad, România"
        label={`${settings?.city ?? 'Arad'} · ${t('cta.viewMap')}`}
      />
      <div>
        {
          settings?.city && (
            <p class="text-2xl">
              {lang === 'en' ? `${settings.city}, Romania` : `${settings.city}, România`}
            </p>
          )
        }
        {settings?.phone && <p class="font-display mt-2 text-3xl">{settings.phone}</p>}
        <div class="mt-7">
          <ContactButtons
            settings={settings}
            lang={lang}
            buttons={['call', 'message']}
            messageHref={routes.contact[lang]}
          />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
