---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../Gallery.astro';
import VideoEmbed from '../VideoEmbed.astro';
import StatusBadge from '../StatusBadge.astro';
import ContactButtons from '../ContactButtons.astro';
import JsonLd from '../JsonLd.astro';
import {
  useTranslations,
  localized,
  animalBase,
  localizedRoute,
  type Lang,
} from '../../i18n/ui';
import { getSiteSettings } from '../../sanity/lib/queries';
import { animalProductSchema, ogImageUrl } from '../../sanity/lib/seo';
import { urlFor } from '../../sanity/lib/image';
import type { Animal } from '../../sanity/lib/types';

interface Props {
  lang: Lang;
  animal: Animal;
}
const { lang, animal } = Astro.props;
const t = useTranslations(lang);

const settings = await getSiteSettings();

const description =
  localized(animal.descriptionRo, animal.descriptionEn, lang) ?? '';
const breedLabel = t(`breed.${animal.breed}` as const);
const genderLabel = animal.gender
  ? t(`animal.gender.${animal.gender}` as const)
  : undefined;

const roPath = `${animalBase.ro}/${animal.slug}`;
const enPath = `${animalBase.en}/${animal.slug}`;
const pageUrl = new URL(lang === 'en' ? enPath : roPath, Astro.site ?? 'https://blindete.ro').href;

const cover = animal.photos?.[0];
const ogImg = cover ? ogImageUrl(cover) : undefined;
const schemaImages = (animal.photos ?? [])
  .slice(0, 5)
  .map((p) => urlFor(p).width(1200).auto('format').url());

const seoDesc =
  description ||
  (lang === 'en'
    ? `${animal.name} — ${breedLabel}. ${t(`status.${animal.status}`)}.`
    : `${animal.name} — ${breedLabel}. ${t(`status.${animal.status}`)}.`);

const schema = animalProductSchema(animal, {
  url: pageUrl,
  description: seoDesc,
  images: schemaImages,
});

const birthdate = animal.birthdate
  ? new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'ro-RO', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(new Date(animal.birthdate))
  : undefined;

const priceLabel =
  typeof animal.price === 'number'
    ? new Intl.NumberFormat(lang === 'en' ? 'en-GB' : 'ro-RO').format(animal.price) + ' RON'
    : t('animal.priceOnRequest');

const backHref = localizedRoute(animal.species === 'cat' ? 'cats' : 'dogs', lang);
---

<BaseLayout
  title={`${animal.name} — ${breedLabel} | Blândețe`}
  description={seoDesc}
  roPath={roPath}
  enPath={enPath}
  ogImage={ogImg}
  ogType="product"
  settings={settings}
>
  <JsonLd slot="head" schema={schema} />

  <article class="mx-auto max-w-5xl px-4 py-8">
    <a href={backHref} class="text-sm text-[var(--color-mut)] hover:text-[var(--color-brand)]">
      ← {t('animal.backToList')}
    </a>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-semibold sm:text-4xl">{animal.name}</h1>
      <StatusBadge status={animal.status} lang={lang} />
    </div>
    <p class="mt-1 text-[var(--color-mut)]">{breedLabel}</p>

    <div class="mt-6 grid gap-8 lg:grid-cols-[1.4fr_1fr]">
      <div class="space-y-6">
        {animal.photos?.length > 0 && <Gallery images={animal.photos} name={animal.name} />}
        {animal.video && (
          <div>
            <h2 class="mb-3 text-xl font-semibold">{t('animal.video')}</h2>
            <VideoEmbed url={animal.video} title={animal.name} />
          </div>
        )}
      </div>

      <aside class="space-y-8">
        {description && (
          <p class="whitespace-pre-line leading-relaxed text-[var(--color-mut)]">{description}</p>
        )}

        <!-- Gold editorial stat blocks (Figma) -->
        <dl class="space-y-5">
          {genderLabel && (
            <div>
              <dd class="font-display text-2xl text-[var(--color-gold)]">{genderLabel}</dd>
              <dt class="eyebrow mt-1">{t('animal.gender')}</dt>
            </div>
          )}
          {birthdate && (
            <div>
              <dd class="font-display text-2xl text-[var(--color-gold)]">{birthdate}</dd>
              <dt class="eyebrow mt-1">{t('animal.birthdate')}</dt>
            </div>
          )}
          <div>
            <dd class="font-display text-2xl text-[var(--color-gold)]">{priceLabel}</dd>
            <dt class="eyebrow mt-1">{t('animal.price')}</dt>
          </div>
        </dl>

        <div class="border-t border-[var(--color-line)] pt-6">
          <ContactButtons settings={settings} lang={lang} context={animal.name} />
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
