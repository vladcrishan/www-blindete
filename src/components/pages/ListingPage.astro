---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnimalCard from '../AnimalCard.astro';
import ProtectedImage from '../ProtectedImage.astro';
import {
  useTranslations,
  routes,
  litterPath,
  localized,
  formatPrice,
  type Lang,
} from '../../i18n/ui';
import {
  getOffspringBySpecies,
  getLittersBySpecies,
  getLanding,
  getSiteSettings,
} from '../../sanity/lib/queries';
import { ogImageUrl } from '../../sanity/lib/seo';
import type { Species, AnimalStatus } from '../../sanity/lib/types';

interface Props {
  lang: Lang;
  species: Species;
}
const { lang, species } = Astro.props;
const t = useTranslations(lang);
const isCat = species === 'cat';

const [offspring, litters, landing, settings] = await Promise.all([
  getOffspringBySpecies(species),
  getLittersBySpecies(species),
  getLanding(species),
  getSiteSettings(),
]);

const routeId = isCat ? 'catsListing' : 'dogsListing';
const title = t(isCat ? 'nav.kittens' : 'nav.puppies');

const copy = {
  ro: {
    young: isCat ? 'pisoi' : 'căței',
    intro: isCat
      ? 'Pisoii noștri pleacă acasă cu pedigree, vaccinați și microcipați.'
      : 'Cățeii noștri pleacă acasă cu pedigree, vaccinați și microcipați.',
    litters: 'Cuiburi',
    loose: isCat ? 'Pisoi disponibili' : 'Căței disponibili',
    born: 'Născuți',
    ready: 'Gata de plecare',
    parents: 'Părinți',
    from: 'de la',
    onRequest: 'Preț la cerere',
    view: 'Vezi cuibul',
    emptyTitle: 'Momentan nu avem un cuib disponibil',
    emptyBody: isCat
      ? 'Contactează-ne pentru a intra pe lista de așteptare pentru următorii pisoi.'
      : 'Contactează-ne pentru a intra pe lista de așteptare pentru următorii căței.',
    contact: 'Contactează-ne',
    footnote: isCat
      ? 'Pisoii pleacă acasă de la 13 săptămâni, vaccinați, microcipați și cu pedigree.'
      : 'Cățeii pleacă acasă de la 12 săptămâni, vaccinați, microcipați și cu pedigree.',
    tag: ['Pentru crescători', 'și iubitori'],
  },
  en: {
    young: isCat ? 'kittens' : 'puppies',
    intro: isCat
      ? 'Our kittens leave home with a pedigree, vaccinated and microchipped.'
      : 'Our puppies leave home with a pedigree, vaccinated and microchipped.',
    litters: 'Litters',
    loose: isCat ? 'Available kittens' : 'Available puppies',
    born: 'Born',
    ready: 'Ready to go',
    parents: 'Parents',
    from: 'from',
    onRequest: 'Price on request',
    view: 'View litter',
    emptyTitle: 'No litter available right now',
    emptyBody: isCat
      ? 'Contact us to join the waiting list for our next kittens.'
      : 'Contact us to join the waiting list for our next puppies.',
    contact: 'Contact us',
    footnote: isCat
      ? 'Kittens leave home from 13 weeks, vaccinated, chipped and with a pedigree.'
      : 'Puppies leave home from 12 weeks, vaccinated, chipped and with a pedigree.',
    tag: ['For breeders', 'and pets'],
  },
}[lang];

const intro = localized(landing?.youngIntroRo, landing?.youngIntroEn, lang) || copy.intro;

const seoTitle = `${title} · ${t('brand.name')}`;
const seoDesc = isCat
  ? lang === 'en'
    ? 'Persian Chinchilla kittens with pedigree, available, reserved and sold in Arad, Romania.'
    : 'Pisoi Persani Chinchilla cu pedigree, disponibili, rezervați și vânduți în Arad, România.'
  : lang === 'en'
    ? 'Pomeranian / Kleinspitz puppies with pedigree, available, reserved and sold in Arad, Romania.'
    : 'Căței Pomeranian / Kleinspitz cu pedigree, disponibili, rezervați și vânduți în Arad, România.';

const footerSocials = isCat
  ? { facebook: settings?.facebook, instagram: settings?.instagram }
  : { facebook: settings?.facebookDog, instagram: settings?.instagramDog };

const loose = offspring.filter((a) => !a.litter);
const allYoung = [...offspring];
const count = (s: AnimalStatus) => allYoung.filter((a) => a.status === s).length;

const firstPhoto =
  litters.find((l) => l.photos?.[0])?.photos?.[0] ?? offspring.find((a) => a.photos?.[0])?.photos[0];
const ogImg = firstPhoto
  ? ogImageUrl(firstPhoto)
  : settings?.heroImage
    ? ogImageUrl(settings.heroImage)
    : undefined;

const filters: { value: AnimalStatus | 'all'; label: string }[] = [
  { value: 'all', label: t('list.filter.all') },
  { value: 'available', label: t('status.available') },
  { value: 'reserved', label: t('status.reserved') },
  { value: 'upcoming', label: t('status.upcoming') },
  { value: 'sold', label: t('status.sold') },
];

const locale = lang === 'en' ? 'en-GB' : 'ro-RO';
const fmtDate = (d?: string) =>
  d
    ? new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' }).format(
        new Date(d),
      )
    : '';
const fmtPrice = (n: number) => formatPrice(n, lang);
const contactHref = routes.contact[lang];
const hasAnything = litters.length > 0 || loose.length > 0;
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  roPath={routes[routeId].ro}
  enPath={routes[routeId].en}
  ogImage={ogImg}
  settings={settings}
  footerSocials={footerSocials}
  subsite={species}
>
  <div class="mx-auto max-w-[1288px] px-6 pt-10 pb-16 md:pt-14 md:pb-24">
    <header class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <h1 class="font-sans text-6xl leading-none font-normal tracking-tight sm:text-7xl md:text-8xl">
          {title}
        </h1>
        <p class="text-mute mt-6 max-w-xl leading-relaxed">{intro}</p>
      </div>
      <div class="flex items-end gap-8 md:gap-12">
        {
          offspring.length > 0 &&
            (['available', 'reserved', 'sold'] as AnimalStatus[]).map((s) => (
              <div>
                <div class="text-4xl leading-none">{count(s)}</div>
                <div class="text-mute mt-2 text-[0.7rem] tracking-[0.2em] uppercase">
                  {t(`status.${s}` as const)}
                </div>
              </div>
            ))
        }
      </div>
    </header>

    <div class="border-ink mt-10 border-t"></div>

    {
      !hasAnything && (
        <section class="bg-cream-soft mt-12 px-6 py-16 text-center md:py-24">
          <p class="eyebrow">{copy.litters}</p>
          <h2 class="mt-4 font-sans text-3xl md:text-4xl">{copy.emptyTitle}</h2>
          <p class="text-mute mx-auto mt-4 max-w-md leading-relaxed">{copy.emptyBody}</p>
          <a href={contactHref} class="btn-sand mt-8 inline-block">
            {copy.contact}
          </a>
        </section>
      )
    }

    {
      litters.length > 0 && (
        <section class="mt-12">
          <h2 class="eyebrow">{copy.litters}</h2>
          <div class="mt-6 grid gap-x-8 gap-y-12 md:grid-cols-2">
            {litters.map((l) => {
              const photo = l.photos?.[0] ?? l.young.find((y) => y.photos?.[0])?.photos[0];
              const parents =
                [l.sire?.name, l.dam?.name].filter(Boolean).join(' × ') || l.parents || '';
              const av = l.young.filter((y) => y.status === 'available').length;
              const summary = l.young.length
                ? lang === 'en'
                  ? `${av} of ${l.young.length} available`
                  : `${av} din ${l.young.length} disponibili`
                : '';
              return (
                <a href={litterPath(species, l.slug, lang)} class="group block">
                  <div class="bg-cream-soft aspect-[3/2] overflow-hidden">
                    {photo ? (
                      <ProtectedImage
                        image={photo}
                        alt={photo.alt ?? l.title}
                        width={900}
                        aspect="3/2"
                        sizes="(max-width: 768px) 100vw, 580px"
                        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                        wrapperClass="h-full w-full"
                      />
                    ) : (
                      <div class="text-mute flex h-full items-center justify-center text-xs tracking-[0.2em] uppercase">
                        blîndețe
                      </div>
                    )}
                  </div>
                  <div class="mt-5 flex items-baseline justify-between gap-4">
                    <h3 class="font-sans text-2xl md:text-3xl">{l.title}</h3>
                    {summary && <span class="text-sand-dark text-sm">{summary}</span>}
                  </div>
                  <dl class="text-mute mt-3 space-y-1 text-sm">
                    {parents && (
                      <div>
                        {copy.parents}: <span class="text-ink">{parents}</span>
                      </div>
                    )}
                    {l.birthdate && (
                      <div>
                        {copy.born}: <span class="text-ink">{fmtDate(l.birthdate)}</span>
                      </div>
                    )}
                    {l.expectedAvailableDate && (
                      <div>
                        {copy.ready}: <span class="text-ink">{fmtDate(l.expectedAvailableDate)}</span>
                      </div>
                    )}
                    <div>
                      <span class="text-ink">
                        {l.priceFrom ? `${copy.from} ${fmtPrice(l.priceFrom)}` : copy.onRequest}
                      </span>
                    </div>
                  </dl>
                  <span class="see-more mt-4">
                    <span class="see-more__label">{copy.view}</span>
                    <span class="see-more__line" />
                  </span>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    {
      loose.length > 0 && (
        <section class="mt-16">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
            <h2 class="eyebrow">{copy.loose}</h2>
            <div class="flex flex-wrap gap-5 text-sm" data-filters>
              {filters.map((f) => (
                <button
                  type="button"
                  data-filter={f.value}
                  aria-pressed={f.value === 'all' ? 'true' : 'false'}
                  class:list={[
                    'hover:text-sand-dark tracking-wide transition',
                    f.value === 'all' ? 'text-ink underline underline-offset-8' : 'text-mute',
                  ]}
                >
                  {f.label}
                </button>
              ))}
            </div>
          </div>
          <div class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" data-grid>
            {loose.map((animal) => (
              <AnimalCard animal={animal} lang={lang} />
            ))}
          </div>
          <p class="text-mute mt-8 hidden" data-empty>
            {t('list.empty')}
          </p>
        </section>
      )
    }

    <p class="text-mute mt-16 text-xs">{copy.footnote}</p>
  </div>
</BaseLayout>

<script is:inline>
  const wrap = document.querySelector('[data-filters]');
  if (wrap) {
    const buttons = [...wrap.querySelectorAll('[data-filter]')];
    const items = [...document.querySelectorAll('[data-grid] [data-status]')];
    const empty = document.querySelector('[data-empty]');

    wrap.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-filter]');
      if (!btn) return;
      const val = btn.getAttribute('data-filter');

      buttons.forEach((b) => {
        const on = b === btn;
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        b.classList.toggle('text-ink', on);
        b.classList.toggle('underline', on);
        b.classList.toggle('underline-offset-8', on);
        b.classList.toggle('text-mute', !on);
      });

      let visible = 0;
      items.forEach((item) => {
        const show = val === 'all' || item.getAttribute('data-status') === val;
        item.hidden = !show;
        if (show) visible++;
      });
      if (empty) empty.classList.toggle('hidden', visible !== 0);
    });
  }
</script>
