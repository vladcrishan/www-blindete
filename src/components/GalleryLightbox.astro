---
/**
 * Lightbox dialog for the gallery. Markup only; behaviour lives in GalleryPage
 * (it knows the current filter). Full-size image src is set lazily on open.
 */
interface Props {
  labels: { close: string; prev: string; next: string; hint: string; enquire: string; contactHref: string };
}
const { labels } = Astro.props;
---

<dialog
  id="gallery-lightbox"
  aria-label="Gallery"
  class="m-0 h-full max-h-none w-full max-w-none bg-white p-0 backdrop:bg-black/60"
>
  <div class="mx-auto flex h-full max-w-[1200px] flex-col px-4 py-4 sm:px-6 lg:px-0 lg:py-6">
    <div class="flex items-center justify-between">
      <p class="eyebrow">
        <span data-lb="eyebrow"></span> · <span data-lb="counter"></span>
      </p>
      <button type="button" data-lb="close" class="flex items-center gap-2 py-2 pl-3 text-sm">
        {labels.close}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13"></path></svg>
      </button>
    </div>

    <div class="mt-3 grid min-h-0 flex-1 gap-6 overflow-y-auto lg:mt-4 lg:grid-cols-[minmax(0,780px)_1fr] lg:gap-[60px] lg:overflow-visible">
      <div class="flex min-h-0 flex-col">
        <div data-protected class="protected-photo relative flex min-h-0 flex-1 items-center justify-center overflow-hidden bg-cream-soft">
          <img data-lb="img" alt="" class="max-h-[60vh] w-full object-contain lg:max-h-[calc(100vh-260px)]" decoding="async" />
          <span class="protected-photo__mark protected-photo__mark--center" aria-hidden="true">blîndețe</span>
          <button type="button" data-lb="prev" aria-label={labels.prev} class="absolute left-3 top-1/2 z-10 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-white shadow-sm">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 2L4 8l6 6"></path></svg>
          </button>
          <button type="button" data-lb="next" aria-label={labels.next} class="absolute right-3 top-1/2 z-10 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-white shadow-sm">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 2l6 6-6 6"></path></svg>
          </button>
        </div>
        <div data-lb="thumbs" data-protected class="mt-3 flex gap-3 overflow-x-auto pb-1" role="list"></div>
        <p class="text-mute mt-2 text-xs">{labels.hint}</p>
      </div>

      <aside class="flex flex-col">
        <p class="eyebrow" data-lb="cat"></p>
        <h2 class="mt-3 font-serif text-3xl leading-tight sm:text-4xl" data-lb="caption"></h2>
        <div class="flex-1"></div>
        <a href={labels.contactHref} class="btn-sand mt-8 w-full text-center">{labels.enquire}</a>
      </aside>
    </div>
  </div>
</dialog>
