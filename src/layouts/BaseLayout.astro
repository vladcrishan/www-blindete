---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import Loader from '../components/Loader.astro';
import { getLangFromUrl, type Lang } from '../i18n/ui';
import { getSiteSettings } from '../sanity/lib/queries';
import type { SiteSettings, Species } from '../sanity/lib/types';

interface Props {
  title: string;
  description: string;
  roPath: string;
  enPath: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  /** Pass already-fetched settings to avoid a second query (optional). */
  settings?: SiteSettings | null;
  /**
   * Breed-specific social links for the enriched footer (breed pages only).
   * Omit on general pages to render the footer without social links.
   */
  footerSocials?: { facebook?: string; instagram?: string };
  /** When set, the header renders the species-scoped sub-site nav. */
  subsite?: Species;
}

const {
  title,
  description,
  roPath,
  enPath,
  ogImage,
  ogType = 'website',
  noindex = false,
  settings: settingsProp,
  footerSocials,
  subsite,
} = Astro.props;

const lang: Lang = getLangFromUrl(Astro.url);
const settings = settingsProp ?? (await getSiteSettings());
---

<!doctype html>
<html lang={lang} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Design fonts: Jost (UI/headings) + Gelasio (logo, editorial titles). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Gelasio:ital,wght@0,400;0,700;1,400&family=Jost:wght@300;400;500;600&display=swap"
    />

    <SEO
      title={title}
      description={description}
      lang={lang}
      roPath={roPath}
      enPath={enPath}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />

    <slot name="head" />
  </head>
  <body class="flex min-h-full flex-col">
    <Loader />
    <Header subsite={subsite} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer settings={settings} socials={footerSocials} />

    <!-- Photo protection: block the context menu and drag on protected photos
         (and on the gallery/lightbox dialogs that render them). -->
    <script is:inline>
      ['contextmenu', 'dragstart'].forEach((type) =>
        document.addEventListener(type, (e) => {
          const el = e.target;
          if (el instanceof Element && el.closest('[data-protected]')) e.preventDefault();
        }),
      );
    </script>
  </body>
</html>
