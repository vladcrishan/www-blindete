---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import { getLangFromUrl, type Lang } from '../i18n/ui';
import { getSiteSettings } from '../sanity/lib/queries';
import type { SiteSettings, Species } from '../sanity/lib/types';

interface Props {
  title: string;
  description: string;
  roPath: string;
  enPath: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  /** Pass already-fetched settings to avoid a second query (optional). */
  settings?: SiteSettings | null;
  /**
   * Breed-specific social links for the enriched footer (breed pages only).
   * Omit on general pages to render the footer without social links.
   */
  footerSocials?: { facebook?: string; instagram?: string };
  /** When set, the header renders the species-scoped sub-site nav. */
  subsite?: Species;
}

const {
  title,
  description,
  roPath,
  enPath,
  ogImage,
  ogType = 'website',
  noindex = false,
  settings: settingsProp,
  footerSocials,
  subsite,
} = Astro.props;

const lang: Lang = getLangFromUrl(Astro.url);
const settings = settingsProp ?? (await getSiteSettings());
---

<!doctype html>
<html lang={lang} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      lang={lang}
      roPath={roPath}
      enPath={enPath}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />

    <slot name="head" />
  </head>
  <body class="flex min-h-full flex-col">
    <Header subsite={subsite} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer settings={settings} socials={footerSocials} />
  </body>
</html>
