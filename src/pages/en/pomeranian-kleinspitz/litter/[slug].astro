---
import LitterPage from '../../../../components/pages/LitterPage.astro';
import { getLittersBySpecies } from '../../../../sanity/lib/queries';

export async function getStaticPaths() {
  const litters = await getLittersBySpecies('dog');
  return litters.map((litter) => ({ params: { slug: litter.slug }, props: { litter } }));
}

const { litter } = Astro.props;
---

<LitterPage lang="en" species="dog" litter={litter} />
