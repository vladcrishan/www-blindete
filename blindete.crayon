                  ]
                },
                {
                  "type": "frame",
                  "id": "wWK12",
                  "name": "Reading column",
                  "gap": 24,
                  "height": "fit_content",
                  "layout": "vertical",
                  "width": 640,
                  "children": [
                    {
                      "type": "text",
                      "id": "afO5R",
                      "name": "Paragraph",
                      "content": "Early on Sunday morning, after a quiet night in the whelping room, Luna delivered four healthy Pomeranian puppies: two cream and two orange sable. All four were nursing within the hour, and by lunchtime the whole kennel had settled into the calm that follows a good birth.",
                      "fill": "$ink",
                      "fontFamily": "Gelasio",
                      "fontSize": 16,
                      "lineHeight": 1.7,
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    },
                    {
                      "type": "text",
                      "id": "EKHkM",
                      "name": "Paragraph",
                      "content": "Luna is a first-time mother, but she has taken to the role as if she had done it for years. The sire, our champion Bruno, is a compact, plush-coated male whose temperament we have wanted to carry forward for a long time. Both parents passed full health screening, including heart, patella and eyes, well before the mating.",
                      "fill": "$ink",
                      "fontFamily": "Gelasio",
                      "fontSize": 16,
                      "lineHeight": 1.7,
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    },
                    {
                      "type": "frame",
                      "id": "T6uHp",
                      "name": "Pull quote",
                      "height": "fit_content",
                      "layout": "vertical",
                      "margin": 0,
                      "padding": [
                        28,
                        0,
                        28,
                        0
                      ],
                      "stroke": "$sand",
                      "strokeWidth": {
                        "bottom": 2,
                        "left": 0,
                        "right": 0,
                        "top": 2
                      },
                      "width": "fill_container",
                      "children": [
                        {
                          "type": "text",
                          "id": "UjRbp",
                          "name": "Quote",
                          "content": "“A good litter is never an accident. It is years of careful choices, and a few sleepless nights.”",
                          "fill": "$ink",
                          "fontFamily": "Gelasio",
                          "fontSize": 26,
                          "fontStyle": "italic",
                          "lineHeight": 1.35,
                          "textGrowth": "fixed-width",
                          "width": "fill_container"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "izdag",
                      "name": "Paragraph",
                      "content": "For the first three weeks the puppies stay in the whelping room, where we weigh them every day and keep a close eye on their progress. After that they move into the family living area, so they grow up with the sounds of a real home: voices, footsteps, the vacuum cleaner and the occasional visitor.",
                      "fill": "$ink",
                      "fontFamily": "Gelasio",
                      "fontSize": 16,
                      "lineHeight": 1.7,
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    },
                    {
                      "type": "text",
                      "id": "hFAGi",
                      "name": "Paragraph",
                      "content": "The puppies will be ready to leave at twelve weeks, vaccinated, microchipped and with a pedigree. We are not taking deposits just yet, but if you would like to meet the family or join the waiting list, please get in touch and we will gladly arrange a visit.",
                      "fill": "$ink",
                      "fontFamily": "Gelasio",
                      "fontSize": 16,
                      "lineHeight": 1.7,
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    }
                  ]
                }
