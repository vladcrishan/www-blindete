# Sanity project configuration
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit your real tokens.

# Your Sanity project ID (found at https://www.sanity.io/manage)
SANITY_PROJECT_ID=

# Dataset name (almost always "production")
SANITY_DATASET=

# Sanity API version (date string). Bump only if you know you need newer APIs.
SANITY_API_VERSION=

# These PUBLIC_ vars are read by the embedded Studio (/admin), which runs in the
# browser — Astro only exposes PUBLIC_-prefixed vars on import.meta.env client-side.
# They must match the values above (projectId/dataset are public, not secrets).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=
